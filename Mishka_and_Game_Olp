#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    int count = 0 , count1 = 0;
    for (int i = 0; i < t; i++) {
        int a , b;
        cin >> a >> b;
        if(a > b) count++;
        else if(b > a) count1++;
    }
    if(count > count1) {
        cout << "Mishka" << endl;
    }
    else if(count1 > count) {
        cout << "Chris" << endl;
    }
    else {
        cout << "Friendship is magic!^^" << endl;
    }
}