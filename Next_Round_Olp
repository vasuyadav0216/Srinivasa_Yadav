#include <bits/stdc++.h>
using namespace std;

int main() {
    int  n,m;
    cin >> n >> m;

    vector<int> v;
    int count = 0;

    for (int i = 0; i < n; i++) {
        int x; cin >> x;
        v.push_back(x);
    }
    for (int i = 0; i < n; i++) 
    {
        if (v[i] > 0 && v[i] >= v[m-1])
        count++;
    }
    cout << count;
}