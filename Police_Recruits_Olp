#include <bits/stdc++.h>
using namespace std;

int main() {
    int x;
    cin >> x;
    int police = 0;
    int crime = 0;
    for (int i = 0; i < x; i++)
    {
        int n;
        cin >> n;
        if (n == -1)
        {
            if (police > 0)
                police--;
            else
                crime++;

        }
        else
            police+=n;
    }
    cout << crime;
}