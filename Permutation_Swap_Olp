#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--) {
        int n;
        cin >> n;
        vector<int> v1(n) , v2 , v3;
        for (int i = 0; i < n; i++) {
            cin >> v1[i];
        }
        v2 = v1;
        sort(v2.begin() , v2.end());
        for (int i = 0; i < n; i++) {
            v3.push_back(abs(v1[i] - v2[i]));
        }

        int count = __gcd(v3[0] , v3[1]);
        for (int i = 2; i < n; i++) {
            count = __gcd(count , v3[i]);
        }
        cout << count << endl;

    }
}