#include <bits/stdc++.h>
using namespace std;
#define ll long long int

int main() {
    ll t;
    cin >> t;
    while(t--) {
        ll n; cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
            if(v[i] == 1) {
                v[i]++;
            }
        }
        for (int i = 0; i < n-1; i++) {
            if(v[i+1] % v[i] == 0) {
                v[i+1]++;
            }
            cout << v[i] << " ";
        }
        cout << v[n-1] << endl;
    }
}