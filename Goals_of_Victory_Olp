#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n-1);
        for (int i = 0; i < n-1; i++) cin >> v[i];

        int count = 0;
        for (int i = 0; i < n-1; i++) {
            count+=v[i];
        }
        cout << -count << endl;
    }
}