#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        set <int> s;

        for (auto &c : v) {
            s.insert(c);
        }

        if(s.size() == 1) {
            cout << "YES" << endl;
        }
        else if(s.size() > 2) {
            cout << "NO" << endl;
        }
        else {
            int count = 0 , count1 = 0;
            for (int i = 0; i < n; i++) {
                if(v[i] == v[0]) {
                    count++;
                }
                else if(v[i] == v[n-1]) {
                    count1++;
                }
            }
            int maxi = max(count , count1);
            int mini = min(count , count1);
            if(maxi - mini <= 1) {
                cout << "YES" << endl;
            }
            else {
                cout << "NO" << endl;
            }
        }
    }
}