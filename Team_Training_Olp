#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n , k;
        cin >> n >> k;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        sort(v.begin(), v.end() , greater<int> ());
        int count = 0 , sum = 0;
        for (int i = 0; i < n; i++) {  
            sum++;
            if(sum * v[i] >= k){
                count++;
                sum = 0;
            }
        }
        cout << count << endl;
    }
}