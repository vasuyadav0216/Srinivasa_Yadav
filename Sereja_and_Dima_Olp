#include <bits/stdc++.h>
using namespace std;

int main() {
   int n;
   cin >> n;
   vector<int> a(n);
   for (int i = 0; i < n; i++) {
       cin >> a[i];
   }
   int left = 0 , right = n-1;
   int value_a = 0 , value_b = 0;

   for (int i = 0; i < n; i++) {
        if(a[left] > a[right]){
            if(i%2 == 0)
                value_a += a[left];   
            else 
                value_b += a[left];

            left++;
        }
        else{
            if(i%2 == 0)
                value_a += a[right];   
            else 
                value_b += a[right];
                right--;
        }
   }
   cout << value_a << " " << value_b << endl;
}