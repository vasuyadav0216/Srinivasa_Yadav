#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        int count = 0;
        for (int i = 0; i < n; i++) {
            for (int j = i+1; j < n; j++) {
                if(__gcd(v[i] , v[j]) <= 2) {
                    count++;
                }
                else {
                    continue;
                }
            }
        }
        if(count != 0)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }
}