#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;  cin >> n;

        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        int maa = INT_MAX;
        for (int i = 0; i < n-1; i++) {
            
            int value = v[i+1] - v[i];
            maa = min(maa , value);
        }
        if(maa < 0)
            cout << '0' << endl;

        else 
            cout << (maa/2) + 1 << endl;
    }
}