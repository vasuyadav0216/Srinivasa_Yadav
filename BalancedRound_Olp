#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n , k;
        cin >> n >> k;
        vector<int> v(n);
        int count = 0;
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        sort(v.begin(),v.end());
        int maxi = 0;
        for (int i = 0; i < n-1; i++) {
            if(v[i+1] - v[i] <= k) {
                count++;
                maxi = max(count , maxi);
            }
            else {
                count = 0;
            }
        }
        int total = (n - maxi-1);
        cout << total << endl;

    }
    
}