#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        int two = 0;
        for (int i = 0; i < n; i++) {
            cin >> v[i];
            if(v[i] == 2) two++;
        }
        if(two == 0) {
            cout << 1 << endl;
        }
        else if(two == n) {
            cout << n/2 << endl;
        }
        else if(two % 2 != 0) {
            cout << "-1" << endl;
        }
        else {
            int count = 0;
            for (int i = 0; i < n; i++) {
                if(v[i] == 2) {
                    count++;
                }
                if(count == two/2) {
                    cout << i+1 << endl;
                    break;
                }
            }
        }
    }
}