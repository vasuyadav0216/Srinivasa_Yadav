#include <bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;
    while (t--)
    {
        int a;
        cin >> a;
        vector<int> v(a);
        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }

        int sum = 0;
        for (int i = 0; i < a; i++) {
            if(v[i] < 0)
                sum+=-v[i];
            else 
                sum+=v[i];
        }
        cout<<sum<<endl;
                
    }
    
}