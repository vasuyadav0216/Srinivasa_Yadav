#include <bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;
    for(int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        for(int i = 0; i < n; i++) {
            cin >> v[i];
        }
        int count = 0;
        sort(v.begin() , v.end());

        for (int i = 0; i < n; i+=2)
        {
            if(v[i] == 1 && v[i+1] == 1){
                count++;
            }
            else {
                count+=2;
            }
        }
        if(n % 2 != 0){
            count-=1;
        }
        cout << count << endl;

    }
}