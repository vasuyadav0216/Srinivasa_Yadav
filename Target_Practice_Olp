#include <bits/stdc++.h>
using namespace std;

int main() {
    int  t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int ans = 0;
        for (int i = 1; i <= 10; i++) {
            for(int j = 1; j <= 10; j++) {
                char c;    
                cin >> c;
                if(c == 'X') ans += min({(11-i) , (11-j) , i , j});
            }
        }
        cout << ans << endl;
    }
    
}