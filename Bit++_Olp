#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    int count = 0;

    for (int i = n; i > 0; i--) {
        string s;
        cin >> s;

        if ( s == ("X++") || s == ("++X")) 
        {
            count++;
        } 
        else
        {
            count--;
        }
    }
        cout << count;




}