#include <bits/stdc++.h>
using namespace std;
    // 7
    // 1 3 1 3 2 1 2

        // 2
        // 3 5 2
        // 6 7 4


int main() {
    int n;
    cin >> n;
    vector<int> v1 , v2 , v3;

    vector<int> s(n);
    
    
    for (int i = 0; i < n; i++) {
        cin >> s[i];

        if(s[i] == 1)     
            v1.push_back(i);

        if(s[i] == 2)
            v2.push_back(i);

        if(s[i] == 3) 
            v3.push_back(i);
    }

    int minimum = min({v1.size() , v2.size() , v3.size()});
    cout << minimum << endl;

    for (int i = 0; i < minimum; i++) {

        cout << v1[i]+1 << " " << v2[i]+1 << " " << v3[i]+1 << endl;

    }
}