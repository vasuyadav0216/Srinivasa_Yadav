#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int s = 0; s < t; s++)
    {
        int n , k;
        cin >> n >> k;

        vector<int> a(n) , b(n);
        
        for (int g = 0; g < n; g++)
        {
            cin >> a[g];
        }
        
        for (int g = 0; g < n; g++)
        {
            cin >> b[g];
        }

        sort(a.begin(), a.end());
        sort(b.begin(), b.end());

        int sum = 0;

        for (int i = 0; i < n; i++) 
        {
            for (int j = n-1-i; j >= 0; j--) 
            {
                    if(a[i] < b[j] && k != 0) 
                    {
                        a[i] = b[j];
                        k--;
            } 
        } 
        }
        for (int i = 0; i < n; i++)
        {
            sum +=a[i];
        }
        cout << sum << endl;
    }
}