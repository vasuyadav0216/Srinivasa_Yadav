#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n , k;
        cin >> n >> k;
        vector<int> v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        int maxi = v[0];

        for (int i = 0; i < n; i++) {
            if(i != n-1) {
                maxi = max({maxi , (v[i+1]- v[i])});
            }
            else if(i == n-1) {
                maxi = max({maxi , 2*(k - v[n-1])});
            }
        }
        cout << maxi << endl;

    }
}