#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        int Xor = 0;
        for (int i = 0; i < n; i++) {
            cin >> v[i];
            Xor ^= v[i];
        }
        int count = 0;
        for (int i = 0; i < n; i++) {
            count = count ^ v[i];
        }
        if(n % 2 == 0 && count == 0) {
            cout << "3" << endl;
        }
        else if(n % 2 != 0) {
            cout << count << endl;
        }
        else {
            cout << "-1" << endl;
        }
    }
}