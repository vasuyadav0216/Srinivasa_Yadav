#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        set<int> s;
        for (auto &c : v) {
            s.insert(c);
        }
        
        sort(v.begin() , v.end());
        if(s.size() == 1) {
            cout << "-1" << endl;
        }
        else {
            int count = 0;
            for (int i = 1; i < n; i++) {
                if(v[0] == v[i]) 
                count++;
            }
            count++;
            cout << count << " " << n-count << endl;

            for (int i = 0; i < count; i++) {
                cout << v[i] << " ";
            }
            cout << endl;
            for (int i = count; i < n; i++) {
                cout << v[i] << " ";
            }
            cout << endl;
        }
    }
}