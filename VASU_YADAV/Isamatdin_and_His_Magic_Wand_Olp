#include <bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int a;
        cin >> a;
        vector<int> v(a) , s(a);
        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }
        for (int i = 0; i < a; i++) {
            s[i] = v[i];
        }

        sort(v.begin() , v.end());

        int even = 0;
        int odd = 0;
        for (int i = 0; i < a; i++) {
            if((v[i]%2) == 0) {
                even++;
            }
            else {
                odd++;
            }
        }
            if(even > 0 && odd > 0){
                for (int i = 0; i < a; i++) {
                    cout << v[i] << " " ;
                }
                cout << endl;
            }

            else if((even > 0 && odd == 0 ) || (even == 0 && odd > 0) ){
                for (int i = 0; i < a; i++) {
                    cout << s[i] << " ";
                }
                cout << endl;
            }
    }

}