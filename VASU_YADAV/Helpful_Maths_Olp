#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin >> s;
    vector<char> v;

    for (auto &c : s)
    {
        if(c >= '1' && c <= '3')
        v.push_back(c);
    }

    sort(v.begin(), v.end());

    for (int i = 0; i < v.size(); i++) {
        cout << v[i];
        if(i != v.size()-1)
            cout << "+";
   }
}