#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        int pos = 0 , neg = 0;
        for (int i = 0; i < n; i++) {
            if(v[i] == 1) {
                pos++;
            }
            else {
                neg++;
            }
        }
        int count = 0;
        while(pos < neg || neg % 2 != 0) {
            pos++;
            neg--;
            count++;
        }
        cout << count << endl;
    }
}