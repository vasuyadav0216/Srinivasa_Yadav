#include <bits/stdc++.h>
using namespace std;

int main() {
    int n,h;
    cin >> n >> h;

    int road = 0 ;
    for (int i = 0; i < n; i++) 
    {
        int height;
        cin >> height;

        if (height > h)
            road+=2;

        else 
            road+=1;
    }
    cout << road ;
}