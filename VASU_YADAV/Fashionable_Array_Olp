#include <bits/stdc++.h>
using namespace std;

int main() {

    int t;
    cin >> t;
    while(t--) {
        int a;
        cin >> a;
        vector<int> v(a);  
        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }
        sort(v.begin() , v.end());
        int left = 0 , right = a-1;
        int count = 0 , count1 = 0;
        for (int i = 0; i < a; i++) {
            if((v[left] + v[right]) % 2 != 0) { 
                left++;
                count++;
            }
            else {
                break;
            }
        }
        for (int i = 0; i < a; i++) {
            if((v[right] + v[0]) % 2 != 0) {
                right--;
                count1++;
            }
            else {
                break;
            }
        }
        cout << min(count , count1) << endl;
    }
}