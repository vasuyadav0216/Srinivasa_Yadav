#include <bits/stdc++.h>
using namespace std;

int main()
{
	int t;
	cin >> t;
	for (int i = 0; i < t; i++)
	{
		vector<int> v(7);
		int a = 7;
		for (int i = 0; i < a; i++) {
			cin >> v[i];
		}
		int x = v[0];
		int y = v[1];

		cout << x << " " << y << " " << v[a-1] - x-y << endl;
	}
}
