int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        long long int a , b;
        cin >> a >> b;
        if(a == b) {
            cout << "YES" << endl;
        }
        else if(a % 2 == 0) {
            cout << "YES" << endl;
        }
        else if(b % 2 != 0 && a % 2 != 0) {
            cout << "YES" << endl;
        }
        else if(a % b == 0) {
            cout << "YES" << endl;
        }
        else {
            cout << "NO" << endl;
        }
    }
}