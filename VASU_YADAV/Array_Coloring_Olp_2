#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int a;
        cin >> a;
        vector<int> v(a);
        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }
        int count = 0;
        for (int i = 0; i < a; i++) {
            count += v[i];
        }
        if(count % 2 == 0) {
            cout << "YES" << endl;
        }
        else {
            cout << "NO" << endl;
        }
    }
}