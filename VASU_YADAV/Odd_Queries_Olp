#include <bits/stdc++.h>
using namespace std;
#define ll long long int

int main() {
    ll t;
    cin >> t;
    while(t--) {
        ll n , d;   cin >> n >> d;
        vector<ll> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        vector<ll> pre(n);
        pre[0] = v[0];
        for (int i = 1; i < n; i++) {
            pre[i] = pre[i-1] + v[i];
        }
        // for (int i = 0; i < n; i++) {
        //     cout << pre[i] << " ";
        // }
        // cout << endl;
        
        ll a = 0 , b = 0 , c = 0;
        for (int i = 0; i < d; i++) {
            ll r , l , k;   cin >> l >> r >> k;
            c = (r - l + 1) * k;
            if(l > 1 && r > 1) {
                b = pre[n-1] - pre[r-1] - pre[l-2] + c;
            }
            else {
                b = pre[n-1] - pre[r-1] + c;
            }
            if(b % 2 == 0) {
                cout << "NO" << endl;
            }
            else {
                cout << "YES" << endl;
            }
            
        }
    }
}