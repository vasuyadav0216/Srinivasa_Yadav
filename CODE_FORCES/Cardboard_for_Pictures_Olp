#include <bits/stdc++.h>
using namespace std;
#define ll long long int

ll binary_Search(ll n , ll k , vector<ll> &v) {

    ll sum = 0 , square = 0;
    for (int i = 0; i < n; i++) {
        sum += v[i];
        square += v[i] * v[i];
    }

    ll l = 0, r = sqrt(2e18 /(4*n)) , w = 1;
    while(l <= r) {
        ll mid = l + (r-l) / 2;
        ll val = (4 * n) * (mid * mid) + (sum * 4 * mid) +(square);
        if (val >= k) {
            w = mid;
            r = mid - 1;
        }
        else
            l = mid + 1;
    }
    return w;
}

int main() {
    ll t; cin >> t;
    while(t--)
    {
        ll n , k; cin >> n >> k;
        vector<ll> v(n);
        for (ll i = 0; i < n; i++) {
            cin >> v[i];
        }
        cout << binary_Search(n,k,v) << endl;
    }
}