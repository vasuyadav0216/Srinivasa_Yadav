#include <bits/stdc++.h>
using namespace std;

int main() {

    int rounds;
    cin >> rounds;
    int a,b; 


    // Your task is to find the minimum number of moves you need to do in order to make a divisible by b
    // . It is possible, that you have to make 0 moves, as ais already divisible by b. 

    
    for (int i = 0; i < rounds; i++)
   {
        cin >> a >> b;

       
        int t = a/b + 1; 
        if (a%b == 0)
            cout << "0" << endl;
        else
            cout << (t * b)-a << endl;
   }

}