#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int n;
    cin >> n;
    for (int i = 0; i < n; i++) {
        int a; 
        cin >> a;
        vector<char> s(a);
        for (int i = 0; i < a; i++) {
            cin >> s[i];
        }
        int count = 0;
        int dot = 0;
        int ans = 0;

        for (int i = 0; i < a; i++) {
            if(s[i] == '.') {
                count++;
                dot++;
                ans = max(ans , count);
            }
            else {
                count = 0;
            }
        }
        if(ans >= 3)
            cout << "2" << endl;    
        else 
            cout << dot << endl;
    }
}