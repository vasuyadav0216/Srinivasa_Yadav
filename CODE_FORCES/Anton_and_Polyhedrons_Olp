#include <bits/stdc++.h>
using namespace std;

int main() {
//     Tetrahedron.  4 
//     Cube.  6 .
//     Octahedron. 8.
//     Dodecahedron.12.
//     Icosahedron. 20.
    int number ;
    cin >> number;
    int count = 0;

    for (int i = 0; i < number; i++) {
        string  name;
        cin >> name;

        if (name == "Tetrahedron")
        {
           count+=4;
        }

        else if (name == "Cube")
        {
            count+=6;
        }

        else if (name == "Octahedron")
        {
            count+=8;
        }

        else if (name == "Dodecahedron")
        {
            count+=12;
        }

        else if (name == "Icosahedron")
        {
           count+=20;
        }

    }
    cout << count;


}