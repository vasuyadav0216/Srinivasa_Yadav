#include <bits/stdc++.h>
using namespace std;
#define ll long long int

int main() {
    ll t;
    cin >> t;
    while(t--) {
        ll n; cin >> n;
        
        if(n < 4 || n % 2 != 0) {
            cout << "-1" << endl;
        }
        else if(n == 4 || n == 6) {
            cout << "1 1" << endl;
        }
        else {
            n = n/2;
            cout << (n+2)/3 << " " << n/2 << endl;
        }
    }
} 