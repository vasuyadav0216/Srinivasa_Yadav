#include <bits/stdc++.h>
using namespace std;

int main() {

    int n;
    cin >> n;
    for (int i = 0; i < n; i++) {
        int a;
        cin >> a;
        vector<int> v(a);
        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }
        sort(v.begin(), v.end());
        
        int m = v[0];
        int y = v[a-1];
            
        if(y > m)
        {
            cout << "YES" << endl << m << " " << y ;
            for (int i = 1; i < a-1; i++) {
                cout << " " << v[i];
            }
            cout << endl;
        }
        else if(y == m){
            cout << "NO" << endl;
        }
    }
}