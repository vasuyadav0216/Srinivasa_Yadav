#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        
        int a , b , c , d;
        cin >> a >> b >> c >> d;
        int count = 0;

        if(d < b) {
            cout << "-1" << endl;
            continue;
        }
        else {
            while(d > b) {
                a++;
                b++;
                count++;
            }
            if(a > c) {
                while(a > c) {
                    a--;
                    count++;
                }
            }
            else if (a < c) {
                cout << "-1" << endl;
                continue;
            }
        }
        cout << count << endl;
    }
}