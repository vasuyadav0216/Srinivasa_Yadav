#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int a;
        cin >> a;
        vector<int> v(a);
        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }
        sort(v.begin(), v.end());

        int ans = INT_MIN;
        for (int i = 0; i < a; i+=2) {
           ans = max(ans, (v[i+1] - v[i]));
        }
        cout << ans << endl;
        
    }
}