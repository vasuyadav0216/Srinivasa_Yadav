#include <bits/stdc++.h>
using namespace std;

int main(){
    int t;  cin >> t;
    string s; cin >> s;
    sort(s.begin() , s.end());

    int e = 0, z = 0, n = 0, r = 0, o = 0;

    for (int i = 0; i < t; i++) {
        if(s[i] == 'z')z++;
        if(s[i] == 'e')e++;
        if(s[i] == 'r')r++;
        if(s[i] == 'o')o++;
        if(s[i] == 'n')n++;
    }
    while (e > 0 && o > 0) {
        if(n > 0){
            cout << '1' << ' ';
            n--; 
        }
        else if(z > 0 && r > 0){
            cout << '0' <<' ';
            z--;
        }
        e--;
        o--;
    }
}