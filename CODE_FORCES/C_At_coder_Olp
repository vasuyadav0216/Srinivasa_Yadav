#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int h , w;
    cin >> h >> w;
    int v[h][w];
    for (int i = 0; i < h ; i++) {
       for (int j = 0; j < w; j++) {
            cin>>v[i][j];
       }
    }
    set<int> s;
    for (int i = 0; i < h ; i++) {
        for (int j = 0; j < w; j++) {
            s.insert(v[i][j]);
        }
    }
    map<int,int> ma;
    for (auto &c : s) {
        ma[c]=0;
    }
    for (int i = 0; i < h ; i++) {
        for (int j = 0; j < w; j++) {
            ma[v[i][j]]++;
        }
    }
    int count = 0;
    for (int i = 0; i < h ; i++) {
        for (int j = 0; j < w; j++) {
            count = max(count , ma[v[i][j]]);
        }
    }
    int total = ((h*w)-count);
    cout << total << endl;
}