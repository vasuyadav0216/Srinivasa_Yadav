#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;  cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        int k;  cin >> k;
        sort(v.begin() , v.end());

        if(v[n-1] >= k && v[0] <= k){
            cout << "YES" << endl;
        }
        else {
            cout << "NO" << endl;
        }
        
    }
}