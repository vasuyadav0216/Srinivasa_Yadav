#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n; 
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        map<int , char> ma;

        for (int i = 0; i < n; i++) {
            if(i % 2 == 0) {
                ma[v[i]] = 'R';
            }
            else {
                ma[v[i]] = 'B';
            }
        }
        int count = 0;
        sort(v.begin(), v.end());
        for (int i = 0; i < n-1; i++) {
            if(ma[v[i]] != ma[v[i+1]])
            count++;
        }
        if(count == n-1) {
            cout << "YES" << endl;
        }
        else {
            cout << "NO" << endl;
        }
        
    }
}