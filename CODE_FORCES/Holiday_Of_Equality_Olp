#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    int count = 0;
    int a[t];

    for (int i = 0; i < t; i++) {
        cin >> a[i];
    }

    int srinu = a[0];

    for (int i = 0; i < t; i++) {
        srinu = max(srinu , a[i]);
    }
    for (int i = 0; i < t; i++) {
        count = count + srinu - a[i];
    }
    cout << count;

}