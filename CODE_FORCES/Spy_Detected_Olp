#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    for (int i = t; i > 0; i--) 
    {
        int n;
        cin >> n;
        vector<int> a(n);
        for (auto &x : a) cin >> x;

        int f;
        if (a[0] == a[1]) 
        {
            f = a[0];
        } 
        else 
        {
            f = a[2];
        }

        for (int i = 0; i < n; i++) {
            if (a[i] != f) {
                cout << i + 1 << endl ;
                break;
            }
        }
    }
}