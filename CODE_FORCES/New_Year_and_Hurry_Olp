#include <bits/stdc++.h>
using namespace std;

int main() {
    int a,n;
    cin >> a >> n;
    int count = 0;
    int time = 240 - n;
    vector<int> s;

    for (int i = 1; i <= a; i++) {
        s.push_back(5 * i);
    }

    for(int f : s){
        if(time >= f){
            time -=f;
            count++;
        }
        else{
            break;
        }
    }
    cout << count << endl;
}