#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<char> v(n);
        for (int i = 0; i < n; i++) cin >> v[i];
        
        set<char> s;
        for (auto &c : v) {
            s.insert(c);
        }
        cout << s.size() + v.size() << endl;
    }
}