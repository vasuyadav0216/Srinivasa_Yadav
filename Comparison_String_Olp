#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        string s;
        cin >> s;
        int count = 0 , count1 = 0;
        int maxii = 0 , maxiii = 0;
        for (int i = 0; i < n; i++) {
            if(s[i] == '<') {
                count++;
                maxii = max(count , maxii);
            }
            else {
                count = 0;
            }
            if(s[i] == '>') {
                count1++;
                maxiii = max(maxiii , count1);
            }
            else {
                count1 = 0;
            }
        }
        int maxi = max(maxii , maxiii);
        cout << maxi+1 << endl;
    }
    
}