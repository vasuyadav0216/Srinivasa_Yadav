#include <bits/stdc++.h>
using namespace std;
#define ll long long int

int main() {
    ll t;
    cin >> t;
    while(t--) {
        ll n; cin >> n;
        vector<int> v(n);
        int count = 0;
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        for (int i = 0; i < n-1; i++) {
            if(v[i] == 0 && v[i+1] != 0) {
                count++;
            }
        }
        if(v[0] != 0) {
            count++;
        }
        if(count == 0) {
            cout << 0 << endl;
        }
        else if(count < 2 && count > 0) {
            cout << 1 << endl;
        }
        else {
            cout << 2 << endl;
        }
    }
}