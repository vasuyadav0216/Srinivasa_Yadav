#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--)
    {
        long long int a , k;
        int n;
        cin >> a >> k >> n;
        long long int count = k;
        for (int i = 0; i < n; i++) {
           long long int x ; cin >> x;
           count += min(a - 1, x);
        }
        cout << count << endl;
    }
    
}