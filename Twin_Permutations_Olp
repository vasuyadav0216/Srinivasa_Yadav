#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
        int count = INT_MIN;
        for(int i = 0 ; i < n; i++) {
            count = max({v[i] , count});
        }
        for (int i = 0; i < n; i++) {
            cout << (count - v[i]) + 1 << " ";
        }
        cout << endl;
    }
}