#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int h , w;
    cin >> h >> w;
    string v[h];
    for (int i = 0; i < h; i++) {
        cin >> v[i];
    }
    for (int i = 0; i < h; i++) {
        int count = 0 , ans = 0;  
        for (int j = 0; j < w; j++) {
            if(v[i][j] == 'o') {
                count = 1;
                ans += j;
                break;
            }
        }
        if(count == 1) {
            cout << ans + 1 << endl;
        }
        else {
            cout << "-1" << endl;
        }
    }
}