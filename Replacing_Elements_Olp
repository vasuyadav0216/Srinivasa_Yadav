#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int a , d;
        cin >> a >> d;
        vector<int> v(a);
        int count = 0;
        

        for (int i = 0; i < a; i++) {
            cin >> v[i];
        }
        sort(v.begin() , v.end());

        for (int i = 0; i < a; i++) {
            if(v[i] <= d)
            count++;
        }
            
        if(v[0] + v[1] <= d || count == a){
            cout << "YES" << endl;
        }
        else{
            cout << "NO" << endl;
        }
    }
}